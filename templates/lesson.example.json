  "guidance": [
    "Where a function returns a collection built from a configured list, read the return position before reading the loop body.",
    "A set that is never compared against its configured inputs cannot be observed to be short."
  ],
  "counter_examples": [
    "A loop that returns on the first match is correct when the contract is first-match; the lesson is about set-returning functions."
