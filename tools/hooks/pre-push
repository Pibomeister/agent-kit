#!/bin/sh
# Two refusals on the way out: publishing through a ref that can move, and publishing
# a commit whose own extract does not build.
#
# WHY THIS EXISTS, NOT WHAT IT DOES
# ---------------------------------
# Five lanes commit into one working tree. `git push origin main` publishes whatever
# the branch points at when it runs, and `git push origin HEAD:main` publishes whatever
# HEAD resolves to when it runs -- in both cases the set is computed after the decision
# to push, so a lane that commits in the window between your measurement and your push
# has its work published by you, unreviewed and unasked.
#
# This happened three times in one session. It was written down on the standing brief
# after the first, correctly, including the remedy; the entry did not stop the second or
# the third. A record is not a control. This file is the control.
#
# THE PROPERTY, WHICH IS NOT THE SYNTAX
# -------------------------------------
# The left-hand side of the refspec must name a commit that CANNOT MOVE between the
# revision you measured and the revision you published. `<sha>:main` has that property.
# `HEAD:main` is an explicit refspec, satisfies every word of "push by explicit refspec",
# and does not have it, because HEAD is a name that moves for the same reason main does.
#
# HOW IT DISCRIMINATES, MEASURED RATHER THAN ASSUMED
# --------------------------------------------------
# git feeds pre-push one line per ref as `<local_ref> <local_sha> <remote_ref> <remote_sha>`.
# Measured on this repository:
#     git push origin HEAD:main      -> local_ref='HEAD'
#     git push origin main           -> local_ref='refs/heads/main'
#     git push origin <sha>:main     -> no line at all; the loop body never runs
# So the sha form is admitted by the absence of a moving name, not by a pattern match on
# forty hex characters.
#
# KNOWN HOLE, STATED RATHER THAN PAPERED OVER
# -------------------------------------------
# `git push origin <tag>:main` arrives as `refs/tags/<tag>` and is admitted. A tag can be
# moved, so the property does not strictly hold for it. Nothing in this repository pushes
# main from a tag, and widening the pattern to refuse refs/tags would block the release
# tagging the plan calls for at v0.1.0. It is a hole and it is here in writing.

# ---------------------------------------------------------------------------
# SECOND REFUSAL: the commit on the wire has to build
# ---------------------------------------------------------------------------
# `ak validate` was run by hand in a clean extract before every publish this
# session. `ak build` was not, and it is a separate gate -- so a parity check
# landed, turned the build red, and main was published twice in that state
# without anyone reading it. The habit covered one of the two gates and nobody
# noticed which, because the habit was never written down anywhere it could be
# compared against the gates it was standing in for.
#
# It extracts the sha being pushed rather than running in place. Several lanes
# write to this clone and it is never clean, so `ak build` here measures a
# timestamp: it mixes the commit on the wire with whatever is dirty or staged
# when the hook fires, and can pass for a commit that does not build. The whole
# point of the first refusal is that the subject must be the commit you
# validated; a second gate measuring the working tree would undo it.
#
# It does NOT run `bun test`. CI runs that after clone.sh with AK_REQUIRE_DONORS.
# This gate copies `.donors/` into the extract only when every lock pin is
# present locally, so `ak build`'s validate step runs the pin check. A partial
# or unpinned local clone is not copied: the gate warns and keeps the old skip
# rather than refusing a commit for a property of the working tree. It still
# does not run the test suite. A gate that cries wolf is a gate people pass
# --no-verify to, and that would take the first refusal down with it.
#
# It measures the default install. A skill's packaged mode depends on
# ak.install.yaml, which is gitignored and so never in an archive; the rm below
# makes that hold even for a commit that carries one by force. What the gate
# answers is whether the commit builds with every fail-closed adapter attached
# (ruling `fail-closed-adapter-lifts-ceiling`). On refusal it echoes the
# summary line, whose install clause says so, because a receipt names its
# instrument (AGENTS.md).
#
# It admits the push when it cannot run -- no node_modules, no bun, archive
# fails. A gate that blocks on its own breakage teaches the bypass.
#
# The helper is resolved from the repository root, not from $0. A copy in
# .git/hooks has no sibling, and sourcing a missing file under dash refuses
# every push. If the helper is absent, warn and archive without .donors: both
# refusals still run, and a feature-branch push still goes through.
_ak_root=$(git rev-parse --show-toplevel 2>/dev/null) || _ak_root=
_ak_extract=
if [ -n "$_ak_root" ]; then
  _ak_extract=$_ak_root/tools/hooks/pre-push-extract.sh
fi
if [ -n "$_ak_extract" ] && [ -f "$_ak_extract" ]; then
  . "$_ak_extract"
else
  printf '%s\n' "pre-push: warning: tools/hooks/pre-push-extract.sh is missing; pin check skipped" >&2
  extract_for_gate() {
    _sha=$1
    _dest=$2
    _root=$3
    git -C "$_root" cat-file -e "$_sha^{commit}" 2>/dev/null || return 1
    git -C "$_root" archive "$_sha" 2>/dev/null | tar -x -C "$_dest" 2>/dev/null || return 1
    rm -f "$_dest/ak.install.yaml"
  }
fi

build_gate() {
  sha="$1"
  root=$(git rev-parse --show-toplevel) || return 0
  [ -d "$root/node_modules" ] || return 0
  tmp=$(mktemp -d) || return 0
  extract_for_gate "$sha" "$tmp" "$root" || {
    rm -rf "$tmp"
    printf '%s\n' "pre-push: warning: extract of $sha failed; build gate skipped" >&2
    return 0
  }
  ln -s "$root/node_modules" "$tmp/node_modules" 2>/dev/null || { rm -rf "$tmp"; return 0; }
  out=$(
    cd "$tmp" || exit 1
    unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE
    bun run ak build 2>&1
  )
  status=$?
  rm -rf "$tmp"
  [ "$status" -eq 0 ] && return 0
  printf '%s\n' "$out" | grep '^ERROR' >&2 || true
  printf '%s\n' "$out" | grep '^ak build: .*; install: ' >&2 || true
  printf '%s\n' \
    "" \
    "pre-push: refusing to publish $(git rev-parse --short "$sha"): ak build fails in a" \
    "  clean extract of it. The working tree may well build; this is the commit." \
    "" \
    "  Re-run it the way the gate did:" \
    "      git archive <sha> | tar -x -C \$(mktemp -d)   # then bun run ak build there," \
    "      with no ak.install.yaml in the extract: the default install" >&2
  return 1
}

refused=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] || continue
  case "$local_ref" in
    HEAD|refs/heads/*)
      printf '%s\n' \
        "pre-push: refusing to publish main through '$local_ref', which can move." \
        "" \
        "  You measured some revision. '$local_ref' resolves at push time, so what goes" \
        "  out is whatever the tree holds now -- including other lanes' commits landed" \
        "  since. Right now that is $(git rev-parse --short "$local_sha")." \
        "" \
        "  Push the commit you actually validated, by its sha:" \
        "      git push origin <sha>:main" \
        "" \
        "  To see exactly what that publishes, first:" \
        "      git log --oneline origin/main..<sha>" >&2
      refused=1
      continue
      ;;
  esac
  # Only reached by the sha form, which the first refusal admits. Deleting a
  # branch arrives with an all-zero local sha and nothing to build.
  case "$local_sha" in
    "" | 0000000000000000000000000000000000000000) continue ;;
  esac
  build_gate "$local_sha" || refused=1
done
exit $refused
